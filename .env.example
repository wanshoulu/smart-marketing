# 复制为 .env 后按需填写。所有项都是可选的，不填也能完整跑通演示闭环。
# 本仓库不提交 .env，也不要把真实密钥写进任何受版本控制的文件。

# HTTP 监听端口（默认 3000）
PORT=3000

# ── 真实 LLM（可选）──
# 直连任意 OpenAI 兼容端点。不配置时，外呼话术、Agent 解释、通话质检
# 全部走确定性模板 / 模拟实现，功能不中断但输出不含模型生成内容。
# LLM_DIRECT_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_DIRECT_KEY=
# LLM_DIRECT_MODEL=qwen3.7-flash

# 强制关闭真实 LLM（即使配置了直连也不调用）
# SMART_MKT_REAL_LLM=off

# LLM 超时（毫秒）：直连 12000，Agent 解释/质检 25000
# SMART_MKT_LLM_TIMEOUT_MS=12000
# SM_MODEL_TIMEOUT_MS=25000

# ── 内部模型网关（可选）──
# 原 AI Harbor 平台在 /api/ai-bank/v1/internal/model/v1/chat/completions 提供网关，
# 本仓库不含该网关。若你有自建网关，可用下面两项指过去。
# SM_MODEL_ENDPOINT=http://127.0.0.1:3000/api/ai-bank/v1/internal/model/v1/chat/completions
# AI_BANK_AGENT_RUNTIME_TOKEN=
# AI_BANK_AGENT_RUNTIME_TOKEN_FILE=

# ── 语义向量召回（可选）──
# 用于话术知识库混合召回；未配置或调用失败时自动回落关键词召回。
# QWEN_KEY=
